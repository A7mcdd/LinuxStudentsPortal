while true; do

#id
 while true; do
  echo
  echo "Enter Student ID (4 digits):"
  read id

  case $id in
   [0-9][0-9][0-9][0-9]);;
   *)
    echo "Eror: ID must be exaactly 4 digits!"
    echo
    continue;;
  esac

  checkExit=$(grep "^$id:" students | cut -d: -f1 )
  if [ -n "$checkExit" ]; then
   echo "Erorr: ID already exists!"
   echo
   continue
  fi
  break
 done




#name
 while true; do
  echo
  echo "Enter Full Name (First Last):"
  read name

  case $name in
   *[' ']*)
     break;;
   *)
     echo "Error: You must enter both First and Last name"
     continue;;
  esac
 done 

#date
 while true; do
  echo
  echo "Enter Date of birth day dd/mm/yyyy"
  read date

  case $date in
   [0-3][0-9]/[0-1][0-9]/[0-9][0-9][0-9][0-9]);;
   *)
    echo "Invalid date format! Use dd/mm/yyyy."
    echo
    continue;;
  esac
  break
 done

 firstname=$(echo $name | cut -d' ' -f1 | tr 'A-Z' 'a-z' )
 idpart=$(echo $id | cut -c3-4)
 email="${firstname}_${idpart}@birzeit.edu"
 
 echo "$id:$name:$date:$email" >> students
 echo
 echo "Students added successfully!" 
 echo

 echo
 echo "Do you want to add another student? (y/n):"
 read choice
 if [ $choice != "y" ]; then
  echo "Returning to Main Menu..."
  break
 fi 

done



